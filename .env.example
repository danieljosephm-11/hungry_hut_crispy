# ─── Hungry Hut environment ──────────────────────────────────────────────────
# Copy to server/.env for local development. NEVER commit real secrets.

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:4000

# MongoDB — required in production.
# Local: mongodb://127.0.0.1:27017/hungry-hut
# Atlas: mongodb+srv://<user>:<pass>@<cluster>/hungry-hut
MONGODB_URI=mongodb://127.0.0.1:27017/hungry-hut

# In development only, if MONGODB_URI is unreachable, the server can start a
# disposable in-process MongoDB (data is lost on restart). Set to false to disable.
DEV_EMBEDDED_DB=true

# Authentication
JWT_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=admin@hungryhut.in
ADMIN_PASSWORD=HungryHut@2026
ADMIN_NAME=Hungry Hut Admin

# Optional cloud image storage (Cloudinary). Without these, uploads are stored
# locally in server/uploads and served from /uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Razorpay (India). When keys are present the checkout will offer
# Razorpay UPI/cards and verify every payment signature server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional Google Maps embed (query string is used when no API key is supplied)
MAPS_EMBED_QUERY=Hauz+Khas+New+Delhi+India

# Serve the built React app from the API server (production)
SERVE_CLIENT=true
